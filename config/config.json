{
  "_source_of_truth": "_docs/stage_1.pdf (CVLAB Summer Project, Stage 1: Classification Baselines)",
  "paths": {
    "data_root": "data",
    "features_dir": "results/features",
    "artifacts_dir": "results/artifacts",
    "metrics_dir": "results/metrics",
    "figures_dir": "results/figures"
  },
  "datasets": {
    "dtd": {
      "torchvision": "DTD",
      "partition": 1,
      "n_classes": 47,
      "prompt": "a photo of a {} texture",
      "spec_selected": true
    },
    "fgvc_aircraft": {
      "torchvision": "FGVCAircraft",
      "annotation_level": "variant",
      "n_classes": 100,
      "prompt": "a photo of a {} aircraft",
      "spec_selected": true
    },
    "flowers102": {
      "torchvision": "Flowers102",
      "n_classes": 102,
      "prompt": "a photo of a {} flower",
      "spec_selected": false
    }
  },
  "encoders": {
    "resnet18": {
      "source": "torchvision ResNet18_Weights.IMAGENET1K_V1, penultimate layer",
      "dim": 512,
      "datasets": ["dtd", "fgvc_aircraft", "flowers102"],
      "supervised_heads": true
    },
    "dinov2_vits14": {
      "source": "facebook/dinov2-small, final class token",
      "dim": 384,
      "datasets": ["fgvc_aircraft"],
      "supervised_heads": true
    },
    "clip_rn50": {
      "source": "official OpenAI CLIP RN50, frozen image + text encoders",
      "dim": 1024,
      "datasets": ["dtd", "fgvc_aircraft", "flowers102"],
      "supervised_heads": false,
      "note": "zero-shot branch only, per spec"
    }
  },
  "shots": [5, 10, "full"],
  "subset_seeds": [0, 1, 2],
  "init_seeds": [0, 1, 2],
  "linear_probe": {
    "optimizer": "adamw",
    "lr": 0.001,
    "weight_decay": 0.0001,
    "batch_size": 64,
    "max_epochs": 200,
    "checkpoint_selection": "highest_validation_accuracy"
  },
  "feature_viz": {
    "n_classes": 10,
    "class_seed": 0,
    "max_per_class": 40
  },
  "smoke": {
    "max_epochs": 5
  },
  "stage2": {
    "_source_of_truth": "_docs/stage_2.pdf (Stage 2: Flow Matching to Class Prototypes); design decisions in docs/adr/0007",
    "datasets": ["dtd", "fgvc_aircraft"],
    "branches": {
      "image_prototype": [["dtd", "resnet18"], ["fgvc_aircraft", "resnet18"], ["fgvc_aircraft", "dinov2_vits14"]],
      "clip_text": [["dtd", "clip_rn50"], ["fgvc_aircraft", "clip_rn50"]]
    },
    "spec_selected_branch": "image_prototype",
    "T_values": [4, 12],
    "velocity_net": {
      "hidden": [512, 512],
      "activation": "silu",
      "time_conditioning": "concat_scalar"
    },
    "training": {
      "optimizer": "adamw",
      "lr": 0.001,
      "weight_decay": 0.0001,
      "batch_size": 64,
      "max_epochs": 200,
      "checkpoint_selection": "min_train_loss"
    },
    "feature_space": "l2_normalized"
  }
}
